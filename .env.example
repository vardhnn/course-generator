[TEMPLATE]
# --- Database (PostgreSQL) ---
# Local development: `npm run dev` boots an embedded PostgreSQL automatically
# with exactly these values — no install or Docker needed.
# Production (e.g. Vercel + Neon): DATABASE_URL is the pooled endpoint
# (contains "-pooler"), DIRECT_URL the unpooled one for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/retro_course_studio"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/retro_course_studio"

# --- Generation ---
AI_PROVIDER="auto"
# Live web research for the research stage; without it, research falls back
# to deterministic seed sources.
EXA_API_KEY=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# BYOK migration note:
# The studio no longer requires server-side Gemini or OpenRouter keys for generation.
# Each account configures its own provider under /account/provider.
#
# Optional: context window used for local Ollama requests (default 16384).
# Lower it (e.g. "8192") on machines with little RAM; raise it for bigger models.
# OLLAMA_NUM_CTX="16384"
