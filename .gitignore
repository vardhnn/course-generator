# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the template that documents which keys the app reads stays tracked.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# legacy local SQLite databases (source of the one-off import; keep backed up)
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# local embedded PostgreSQL data
/prisma/pgdata/
/prisma/pgtest/

# scratch scripts and logs
/tmp/
*.log
